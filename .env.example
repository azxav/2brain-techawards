# Copy to .env and fill in only the values this deployment needs.
# .env is gitignored. Never commit real keys, database URLs, or customer data.
#
# A local brain can start with no keys:
#   bun run src/cli.ts init --pglite --no-embedding
# Keyword search works in that mode. Vector retrieval and model answers need a provider.

# --- Brain storage ---
# Embedded PGLite is the local default and does not need a URL.
# Postgres (with pgvector for vector search) uses one of these:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gbrain
# GBRAIN_DATABASE_URL=
# Isolated data directory. Defaults to ~/.gbrain.
# GBRAIN_HOME=

# Workspace control plane (one Workspace and one Brain per deployment).
# Use a new empty database. Do not point this at a legacy brain database.
# TWO_BRAIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/two_brain

# --- Models ---
# Init picks an embedding provider from whichever key is set.
# See docs/integrations/embedding-providers.md.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ZEROENTROPY_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# VOYAGE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GBRAIN_EMBEDDING_MODEL=
# GBRAIN_EMBEDDING_DIMENSIONS=
# GBRAIN_CHAT_MODEL=
# GBRAIN_EXPANSION_MODEL=
# Comma-separated chat model fallbacks.
# GBRAIN_CHAT_FALLBACK_CHAIN=

# --- Workspace web, magic links, and agents ---
# Required together before gbrain serve --http emails setup, login, and invite links.
# GBRAIN_EMAIL_RESEND_API_KEY=
# GBRAIN_EMAIL_FROM=2Brain <no-reply@workspace.example.test>
# GBRAIN_WORKSPACE_BASE_URL=http://127.0.0.1:8787
# Secret used to derive confirmation tokens.
# GBRAIN_WORKSPACE_TOKEN_SECRET=
# Operator credential for outbox and bootstrap routes.
# GBRAIN_BOOTSTRAP_CREDENTIAL=
# Set 1 to force Secure session cookies.
# GBRAIN_WORKSPACE_PRODUCTION=
# Set true on an agent-tier workspace. Agent callers stay untrusted.
# GBRAIN_AGENT_TIER=

# --- HTTP MCP ---
# OAuth client secret when remote MCP is configured.
# GBRAIN_REMOTE_CLIENT_SECRET=
# GBRAIN_HTTP_CORS_ORIGIN=
# GBRAIN_HTTP_TRUST_PROXY=

# Database-backed end-to-end tests. See .env.testing.example.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gbrain_test
