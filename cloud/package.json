{
  "name": "2brain-cloud",
  "description": "2Brain Cloud control plane: fleet registry, GitHub identity, invite-gated signup, workspace provisioning",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "image:check": "bun run image/verify-contract.ts --json",
    "smoke:preflight": "bun run image/smoke-preflight.ts",
    "smoke:provision": "bun run image/smoke-provision.ts",
    "smoke:control-plane": "bash deploy/smoke-control-plane.sh",
    "launch:control-plane": "bash deploy/launch-control-plane.sh"
  },
  "dependencies": {
    "express": "^5.1.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": [
    "@electric-sql/pglite"
  ],
  "engines": {
    "bun": ">=1.3.10"
  }
}
