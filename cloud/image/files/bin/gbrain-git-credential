#!/usr/bin/env bash
set -euo pipefail

# Inert until issue #42 writes /etc/gbrain/git-credential.env and configures
# this path as a Git credential helper for the gbrain service account.
operation="${1:-}"
if [[ "$operation" != "get" ]]; then
  exit 0
fi

protocol=""
host=""
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
  esac
done

if [[ "$protocol" != "https" || "$host" != "github.com" ]]; then
  exit 0
fi

config="${GBRAIN_GIT_CREDENTIAL_ENV:-/etc/gbrain/git-credential.env}"
if [[ ! -r "$config" ]]; then
  exit 0
fi

set -a
# shellcheck disable=SC1090
. "$config"
set +a
: "${GBRAIN_GIT_TOKEN_MINT_URL:?missing GBRAIN_GIT_TOKEN_MINT_URL}"
: "${GBRAIN_GIT_WORKSPACE_TOKEN:?missing GBRAIN_GIT_WORKSPACE_TOKEN}"

response="$(curl --fail --silent --show-error \
  --connect-timeout 5 --max-time 15 \
  --request POST \
  --header "Authorization: Bearer $GBRAIN_GIT_WORKSPACE_TOKEN" \
  --header 'Content-Type: application/json' \
  --data '{"host":"github.com"}' \
  "$GBRAIN_GIT_TOKEN_MINT_URL")"
token="$(jq -er '.token' <<<"$response")"
username="$(jq -er '.username // "x-access-token"' <<<"$response")"

printf 'protocol=https\nhost=github.com\nusername=%s\npassword=%s\n\n' "$username" "$token"
